# ---------------------------------------------------------------------------
# Server-only secrets. Set these in Vercel (Production and Preview). Never prefix
# them with VITE_, which would publish them in the browser bundle.
# ---------------------------------------------------------------------------

# Supabase Postgres through the transaction pooler (port 6543), as the least-privilege
# openswarm_api role from sql/004_api_role.sql, e.g.
# postgresql://openswarm_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave out sslmode: Supabase hosts are verified against the bundled Supabase root CA.
DATABASE_URL=

# Random secret for hashing client IPs (rate limits, referral fraud checks). IPs are never stored.
# Generate with: openssl rand -base64 32
ANALYTICS_SALT=

# Supabase service role key. Used only by /api/admin/invite to create admin logins.
SUPABASE_SERVICE_ROLE_KEY=

# SMTP server for the welcome email (configured in /admin → Settings → Email signup).
# For Google Workspace: smtp.gmail.com, port 587, the mailbox address, and an app password
# for that mailbox. The from address in Settings must be that mailbox or one of its aliases.
# Used when host, user and password are all set; SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Resend API key, used for the welcome email only when SMTP is not set.
# The sending domain must be verified in Resend. With neither set, welcome emails are skipped.
RESEND_API_KEY=

# Cloudflare Turnstile secret. Leave empty to disable the waitlist bot check.
TURNSTILE_SECRET_KEY=

# Optional extra origins allowed to POST to the API (comma-separated), e.g. a preview domain.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Public values, embedded in the browser bundle at build time.
# ---------------------------------------------------------------------------

# Public share-link origin.
VITE_PUBLIC_SITE_URL=https://openswarm.com

# Supabase project URL and anon (publishable) key, used by the /admin dashboard to sign in.
VITE_SUPABASE_URL=https://xhpwfsgrkvrdphvemefq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key. Leave empty to disable the waitlist bot check.
VITE_TURNSTILE_SITE_KEY=

# X Ads "Sign up" conversion event id (tw-<pixel>-<event>). Leave empty to skip the conversion.
VITE_X_SIGNUP_EVENT_ID=

# Optional public base URL for site images (for example a Cloudflare R2 bucket or custom domain).
# Upload the contents of public/media/ there first. Defaults to this site's /media/.
VITE_MEDIA_BASE_URL=

# Optional HTTPS overrides for the built-in /privacy/ and /terms/ pages.
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# ---------------------------------------------------------------------------
# Tests only: a PostgreSQL server where tests may create and drop databases.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
